{
	"name": "cinefi-indexer",
	"version": "1.0.0",
	"description": "Helius webhook indexer for CineFi — decodes on-chain events and forwards them to the backend API",
	"main": "dist/app/indexer/src/server.js",
	"scripts": {
		"dev": "nodemon --watch src --ext ts --exec 'ts-node --project tsconfig.json src/server.ts'",
		"build": "tsc",
		"start": "node dist/app/indexer/src/server.js",
		"prisma:generate": "prisma generate"
	},
	"dependencies": {
		"@coral-xyz/anchor": "^0.32.1",
		"@solana/web3.js": "^1.98.4",
		"axios": "^1.7.9",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@prisma/client": "latest",
		"@types/express": "^5.0.0",
		"@types/node": "^22.13.9",
		"nodemon": "^3.1.9",
		"prisma": "latest",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	}
}
