# ─── RPC Endpoints ──────────────────────────────────────────────────────────
# Solana mainnet RPC URL (use Helius/Alchemy/QuickNode for rate-limit headroom)
MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Solana devnet RPC URL
DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# ─── Backend API ─────────────────────────────────────────────────────────────
# Base URL of your backend server (no trailing slash)
BACKEND_URL=http://localhost:3001

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
